{
  "name": "@starter-saas/starter",
  "version": "0.0.0",
  "private": true,
  "description": "StarterSaaS reference application — minimal HTTP entry running the kit gateway + auth + tenancy subsystems end-to-end. Adopter forks this as their starting point. STORY-016 sub-PR #3 of EPIC-004.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./boot": "./src/boot.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@starter-saas/auth": "*",
    "@starter-saas/gateway": "*",
    "@starter-saas/tenancy": "*",
    "drizzle-orm": "^0.36.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0"
  }
}
