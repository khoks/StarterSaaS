# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Editors / IDEs ---
.idea/
*.swp
*.swo
*~
# Keep shared VS Code config (extensions.json, settings.json) when added under .vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/README.md

# --- Env / secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# --- Node / pnpm / yarn / Turbo (covered for whichever stack lands) ---
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

# --- Python (covered in case of Python services in MVP-1) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Go ---
*.exe
*.exe~
*.dll
*.test
*.out
go.work.sum

# --- Terraform / Pulumi / IaC (deploy script artifacts) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.pulumi/
crash.log
crash.*.log

# --- Docker ---
docker-compose.override.yml

# --- Misc ---
.cache/
tmp/
*.log

# --- Claude Code ---
# Local-only settings overrides; team-wide settings.json IS committed.
.claude/settings.local.json
# Per-session marker files written by the Stop hook (see .claude/hooks/).
.claude/state/
# Local-only memory directory (auto-memory, see CLAUDE.md system prompt).
.claude/memory/
